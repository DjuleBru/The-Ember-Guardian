   "Italian": ""
 },
 {
   "key": "gemTrader_DemoIntro1",
   "English": "<wave a=.2 f=1.5>Hah… Stumbled, did you?</wave> No shame in that. This place exists so you can rise again.",
   "French": "<wave a=.2 f=1.5>Ah… Tu as trébuché, hein ?</wave> Il n'y a aucune honte à ça. Cet endroit existe pour que tu puisses te relever.",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoIntro2",
   "English": "Here, take these. A small <wiggle a=.05 f=2>investment</wiggle> in your survival.",
   "French": "Tiens, prends ça. Un petit <wiggle a=.05 f=2>investissement</wiggle> pour ta survie.",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoIntro3",
   "English": "Drop them in the chest… <bounce a=.2 f=1.2>Only then</bounce> can you make use of them.",
   "French": "Dépose-les dans le coffre… <bounce a=.2 f=1.2>Ce n'est qu'alors</bounce> que tu pourras t'en servir,",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoLevelLostAgain",
   "English": "Another ember, another try. <wiggle a=.05 f=2>How many before the fire holds?</wiggle>",
   "French": "Une autre braise, un autre essai,,. <wiggle a=.05 f=2>Encore combien pour que le feu tienne?</wiggle>",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoLevelLostOnce1",
   "English": "Every ember fades… <wiggle a=.05 f=2>but this one still burns.</wiggle>",
   "French": "Chaque braise s'éteint… <wiggle a=.05 f=2>mais celle-ci tient toujours.</wiggle>",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoLevelLostOnce2",
   "English": "Merchants are stocked up. Ready to trade. <bounce a=.2 f=1.2>Including me.</bounce>",
   "French": "Les marchands sont réapprovisionnés. Prêts à commercer <bounce a=.2 f=1.2>Moi inclus.</bounce>",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoLevelSuccess1",
   "English": "Hah! You held the line. <wave a=.2 f=1.5>The dark recoils… for now.</wave>",
   "French": "Ah! Tu as tenu bon, <wave a=.2 f=1.5>L'obscurité se rétracte,,, pour l'instant.</wave>",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DemoLevelSuccess2",
   "English": "But if you crave the fight, step back in. See how long your ember lasts.",
   "French": "",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
   "key": "gemTrader_DroppedGems",
   "English": "Good. Of course, you could share with the others, but… <shake a=.4>I'd make it worth your while.</shake>",
   "French": "",
   "German": "",
   "Spanish": "",
   "Italian": ""
 },
 {
